# ── Groq LLM ────────────────────────────────────────────────────
# Get free key → https://console.groq.com
GROQ_API_KEY=gsk_...
# Available: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
LLM_MODEL=llama-3.3-70b-versatile

# ── LangSmith Monitoring ─────────────────────────────────────────
# Sign up → https://smith.langchain.com  (free tier available)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=pod-jd-intelligence
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Mailbox (IMAP read) ─────────────────────────────────────────
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=hodaiml_AI@mitaoe.ac.in
# Use an App Password (NOT your login password)
IMAP_PASSWORD=your-16-char-app-password
IMAP_FOLDER=INBOX

# ── SMTP (send approved drafts) ─────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hodaiml_AI@mitaoe.ac.in
SMTP_PASSWORD=your-16-char-app-password

# ── POD allow-list (comma-separated, no spaces) ─────────────────
POD_ALLOWED_SENDERS=placement@mitaoe.ac.in,pod@mitaoe.ac.in,training@mitaoe.ac.in

# ── Recipient lists ──────────────────────────────────────────────
STUDENT_LIST_EMAIL=aiml-students@mitaoe.ac.in
FACULTY_LIST_EMAIL=aiml-faculty@mitaoe.ac.in

# ── Pipeline behaviour ───────────────────────────────────────────
# true  = save drafts locally, do NOT send (safe default)
# false = dispatch via SMTP after pipeline (only after testing)
DRY_RUN=true

# Subject keyword filter (comma-separated, case-insensitive)
JD_SUBJECT_KEYWORDS=placement,job opening,recruitment,hiring,campus drive,internship
