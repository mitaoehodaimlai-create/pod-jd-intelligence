# ================================================================
#  POD-JD Intelligence — Environment Variables
#  Copy this file to .env and fill in your values.
#  The .env file is git-ignored — your keys are never committed.
# ================================================================


# ── 1. GROQ API KEY ──────────────────────────────────────────────
# Free tier available at https://console.groq.com
# Used for all LLM calls (email parsing, student brief, teacher reco)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq model to use for all agents
# Options: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
LLM_MODEL=llama-3.3-70b-versatile


# ── 2. LANGSMITH API KEY (monitoring + tracing) ──────────────────
# Sign up free at https://smith.langchain.com
# Once set, every LLM call is traced and visible in your dashboard.
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable/disable tracing (set to false to turn off without removing the key)
LANGCHAIN_TRACING_V2=true

# Project name shown in LangSmith dashboard
LANGCHAIN_PROJECT=pod-jd-intelligence

# LangSmith server endpoint (default is fine for most users)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ── 3. EMAIL — IMAP (read emails) ────────────────────────────────
# Use an App Password, NOT your login password.
# Gmail:  Google Account → Security → 2-Step → App passwords
# O365:   Settings → Security → Advanced → App passwords
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=hodaiml_AI@mitaoe.ac.in
IMAP_PASSWORD=your-16-char-app-password
IMAP_FOLDER=INBOX


# ── 4. EMAIL — SMTP (send approved drafts) ───────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hodaiml_AI@mitaoe.ac.in
SMTP_PASSWORD=your-16-char-app-password


# ── 5. RECIPIENT LISTS ───────────────────────────────────────────
# Who receives the student prep brief
STUDENT_LIST_EMAIL=aiml-students@mitaoe.ac.in
# Who receives the faculty curriculum recommendations
FACULTY_LIST_EMAIL=aiml-faculty@mitaoe.ac.in


# ── 6. SECURITY — POD ALLOW LIST ─────────────────────────────────
# Only emails FROM these addresses are processed. All others are ignored.
# Comma-separated, no spaces.
POD_ALLOWED_SENDERS=placement@mitaoe.ac.in,pod@mitaoe.ac.in,training@mitaoe.ac.in


# ── 7. BEHAVIOUR ─────────────────────────────────────────────────
# DRY_RUN=true  → drafts are saved locally, nothing is emailed (SAFE DEFAULT)
# DRY_RUN=false → emails are sent immediately after pipeline (use carefully)
DRY_RUN=true

# Email subject must contain at least one of these keywords to be processed
JD_SUBJECT_KEYWORDS=placement,job opening,recruitment,hiring,campus drive,internship
